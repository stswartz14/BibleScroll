rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidVerseKey(key) {
      return key is string && key.size() >= 5 && key.size() <= 15 && key.matches('^[A-Z0-9]{3}_[0-9]{1,3}_[0-9]{1,3}$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTranslation(t) {
      return t is string && (t == 'BSB' || t == 'WEB');
    }

    function isValidUserReadingState(data, userId) {
      return data.keys().hasAll(['uid', 'translation', 'bookId', 'bookName', 'chapter', 'verse', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'translation', 'bookId', 'bookName', 'chapter', 'verse', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && isValidTranslation(data.translation)
        && data.bookId is string
        && data.bookId.size() == 3
        && data.bookId.matches('^[A-Z0-9]{3}$')
        && data.bookName is string
        && data.bookName.size() >= 2
        && data.bookName.size() <= 40
        && data.chapter is int
        && data.chapter >= 1
        && data.chapter <= 150
        && data.verse is int
        && data.verse >= 1
        && data.verse <= 176
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedVerse(data, userId, verseKey) {
      return data.keys().hasAll(['verseKey', 'ownerId', 'bookId', 'bookName', 'chapter', 'verse', 'reference', 'text', 'translation', 'createdAt'])
        && data.keys().hasOnly(['verseKey', 'ownerId', 'bookId', 'bookName', 'chapter', 'verse', 'reference', 'text', 'translation', 'createdAt'])
        && data.verseKey is string
        && data.verseKey == verseKey
        && isValidVerseKey(data.verseKey)
        && data.ownerId is string
        && data.ownerId == userId
        && data.bookId is string
        && data.bookId.size() == 3
        && data.bookId.matches('^[A-Z0-9]{3}$')
        && data.bookName is string
        && data.bookName.size() >= 2
        && data.bookName.size() <= 40
        && data.chapter is int
        && data.chapter >= 1
        && data.chapter <= 150
        && data.verse is int
        && data.verse >= 1
        && data.verse <= 176
        && data.reference is string
        && data.reference.size() >= 3
        && data.reference.size() <= 60
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 4000
        && isValidTranslation(data.translation)
        && data.createdAt is timestamp;
    }

    function hasUserParent(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        || existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidUserReadingState(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidUserReadingState(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['translation', 'bookId', 'bookName', 'chapter', 'verse', 'updatedAt']);
      allow delete: if isOwner(userId);

      match /likes/{verseKey} {
        allow get: if isOwner(userId) && isValidVerseKey(verseKey);
        allow list: if isVerifiedUser()
          && request.auth.uid == userId
          && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidVerseKey(verseKey)
          && isValidSavedVerse(incoming(), userId, verseKey)
          && incoming().createdAt == request.time
          && hasUserParent(userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidVerseKey(verseKey);
      }

      match /bookmarks/{verseKey} {
        allow get: if isOwner(userId) && isValidVerseKey(verseKey);
        allow list: if isVerifiedUser()
          && request.auth.uid == userId
          && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidVerseKey(verseKey)
          && isValidSavedVerse(incoming(), userId, verseKey)
          && incoming().createdAt == request.time
          && hasUserParent(userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidVerseKey(verseKey);
      }
    }
  }
}
