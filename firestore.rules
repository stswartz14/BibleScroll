rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBookId(bookId) {
      return bookId is string && bookId.size() == 3 && bookId.matches('^[A-Z0-9]{3}$');
    }

    function isValidVerseKey(key) {
      return key is string && key.size() >= 5 && key.size() <= 15 && key.matches('^[A-Z0-9]{3}_[0-9]{1,3}_[0-9]{1,3}$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTranslation(t) {
      return t is string && (t == 'BSB' || t == 'WEB' || t == 'NLT' || t == 'NASB' || t == 'CEV');
    }

    function isValidTextSize(s) {
      return s is string && (s == 'S' || s == 'M' || s == 'L' || s == 'XL');
    }

    function isValidFontFamily(f) {
      return f is string && (f == 'serif' || f == 'sans');
    }

    function isValidUserReadingState(data, userId) {
      return data.keys().hasAll(['uid', 'translation', 'bookId', 'bookName', 'chapter', 'verse', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'translation',
          'bookId',
          'bookName',
          'chapter',
          'verse',
          'smartGrouping',
          'currentStreak',
          'longestStreak',
          'lastReadDate',
          'apiBibleKey',
          'textSize',
          'fontFamily',
          'redLetter',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && isValidTranslation(data.translation)
        && isValidBookId(data.bookId)
        && data.bookName is string
        && data.bookName.size() >= 2
        && data.bookName.size() <= 40
        && data.chapter is int
        && data.chapter >= 1
        && data.chapter <= 150
        && data.verse is int
        && data.verse >= 1
        && data.verse <= 176
        && (!('smartGrouping' in data) || data.smartGrouping is bool)
        && (!('currentStreak' in data) || (data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 50000))
        && (!('longestStreak' in data) || (data.longestStreak is int && data.longestStreak >= 0 && data.longestStreak <= 50000))
        && (!('lastReadDate' in data) || (data.lastReadDate is string && data.lastReadDate.size() <= 10 && (data.lastReadDate == '' || data.lastReadDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))))
        && (!('apiBibleKey' in data) || (data.apiBibleKey is string && data.apiBibleKey.size() <= 256))
        && (!('textSize' in data) || isValidTextSize(data.textSize))
        && (!('fontFamily' in data) || isValidFontFamily(data.fontFamily))
        && (!('redLetter' in data) || data.redLetter is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedVerse(data, userId, verseKey) {
      return data.keys().hasAll(['verseKey', 'ownerId', 'bookId', 'bookName', 'chapter', 'verse', 'reference', 'text', 'translation', 'createdAt'])
        && data.keys().hasOnly(['verseKey', 'ownerId', 'bookId', 'bookName', 'chapter', 'verse', 'reference', 'text', 'translation', 'createdAt'])
        && data.verseKey is string
        && data.verseKey == verseKey
        && isValidVerseKey(data.verseKey)
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && isValidBookId(data.bookId)
        && data.bookName is string
        && data.bookName.size() >= 2
        && data.bookName.size() <= 40
        && data.chapter is int
        && data.chapter >= 1
        && data.chapter <= 150
        && data.verse is int
        && data.verse >= 1
        && data.verse <= 176
        && data.reference is string
        && data.reference.size() >= 3
        && data.reference.size() <= 60
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 4000
        && isValidTranslation(data.translation)
        && data.createdAt is timestamp;
    }

    function isValidVerseNote(data, userId, verseKey) {
      return data.keys().hasAll([
          'verseKey',
          'ownerId',
          'bookId',
          'bookName',
          'chapter',
          'verse',
          'reference',
          'verseText',
          'translation',
          'noteKind',
          'noteText',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'verseKey',
          'ownerId',
          'bookId',
          'bookName',
          'chapter',
          'verse',
          'reference',
          'verseText',
          'translation',
          'noteKind',
          'noteText',
          'createdAt',
          'updatedAt'
        ])
        && data.verseKey is string
        && data.verseKey == verseKey
        && isValidVerseKey(data.verseKey)
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && isValidBookId(data.bookId)
        && data.bookName is string
        && data.bookName.size() >= 2
        && data.bookName.size() <= 40
        && data.chapter is int
        && data.chapter >= 1
        && data.chapter <= 150
        && data.verse is int
        && data.verse >= 1
        && data.verse <= 176
        && data.reference is string
        && data.reference.size() >= 3
        && data.reference.size() <= 60
        && data.verseText is string
        && data.verseText.size() >= 1
        && data.verseText.size() <= 4000
        && isValidTranslation(data.translation)
        && data.noteKind is string
        && (data.noteKind == 'note' || data.noteKind == 'prayer')
        && data.noteText is string
        && data.noteText.size() >= 1
        && data.noteText.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReadBook(data, userId, bookId) {
      return data.keys().hasAll(['bookId', 'ownerId', 'versesMap', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['bookId', 'ownerId', 'versesMap', 'createdAt', 'updatedAt'])
        && isValidBookId(data.bookId)
        && data.bookId == bookId
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.versesMap is map
        && data.versesMap.size() <= 2600
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasUserParent(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        || existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidUserReadingState(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidUserReadingState(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'translation',
          'bookId',
          'bookName',
          'chapter',
          'verse',
          'smartGrouping',
          'currentStreak',
          'longestStreak',
          'lastReadDate',
          'apiBibleKey',
          'textSize',
          'fontFamily',
          'redLetter',
          'updatedAt'
        ]);
      allow delete: if isOwner(userId);

      match /likes/{verseKey} {
        allow get: if isOwner(userId) && isValidVerseKey(verseKey);
        allow list: if isVerifiedUser()
          && request.auth.uid == userId
          && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidVerseKey(verseKey)
          && isValidSavedVerse(incoming(), userId, verseKey)
          && incoming().createdAt == request.time
          && hasUserParent(userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidVerseKey(verseKey);
      }

      match /bookmarks/{verseKey} {
        allow get: if isOwner(userId) && isValidVerseKey(verseKey);
        allow list: if isVerifiedUser()
          && request.auth.uid == userId
          && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidVerseKey(verseKey)
          && isValidSavedVerse(incoming(), userId, verseKey)
          && incoming().createdAt == request.time
          && hasUserParent(userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidVerseKey(verseKey);
      }

      match /notes/{verseKey} {
        allow get: if isOwner(userId) && isValidVerseKey(verseKey);
        allow list: if isVerifiedUser()
          && request.auth.uid == userId
          && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidVerseKey(verseKey)
          && isValidVerseNote(incoming(), userId, verseKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserParent(userId);
        allow update: if isOwner(userId)
          && isValidVerseKey(verseKey)
          && isValidVerseNote(incoming(), userId, verseKey)
          && incoming().ownerId == existing().ownerId
          && incoming().verseKey == existing().verseKey
          && incoming().bookId == existing().bookId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'noteKind',
            'noteText',
            'reference',
            'verseText',
            'translation',
            'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidVerseKey(verseKey);
      }

      match /readBooks/{bookId} {
        allow get: if isOwner(userId) && isValidBookId(bookId);
        allow list: if isVerifiedUser()
          && request.auth.uid == userId
          && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidBookId(bookId)
          && isValidReadBook(incoming(), userId, bookId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserParent(userId);
        allow update: if isOwner(userId)
          && isValidBookId(bookId)
          && isValidReadBook(incoming(), userId, bookId)
          && incoming().ownerId == existing().ownerId
          && incoming().bookId == existing().bookId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['versesMap', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidBookId(bookId);
      }
    }
  }
}
